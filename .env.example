# LoopSmith configuration. Copy to .env (never commit .env) or export in your shell.
# Nothing here is required for the offline demo: `pnpm demo` uses the deterministic mock provider.

# Default provider: mock | anthropic | openai | fallback
LOOPSMITH_PROVIDER=mock

# --- Anthropic (official @anthropic-ai/sdk) ---
ANTHROPIC_API_KEY=
# Optional gateway / proxy
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# LOOPSMITH_ANTHROPIC_MODEL=claude-opus-5-5

# --- OpenAI-compatible endpoint (official openai SDK, Chat Completions) ---
# Works with OpenAI and compatible gateways (vLLM, Ollama, LiteLLM, OpenRouter, ...).
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# Required to enable the provider (model names differ per gateway):
# LOOPSMITH_OPENAI_MODEL=

# --- Fallback chain (comma-separated provider names, tried in order) ---
# LOOPSMITH_FALLBACK=anthropic,openai

# --- Runtime ---
# LOOPSMITH_DB=.loopsmith/loopsmith.db
# LOOPSMITH_WORKSPACE=.
# LOOPSMITH_PROVIDER_TIMEOUT_MS=120000
# LOOPSMITH_LOG_LEVEL=warn
